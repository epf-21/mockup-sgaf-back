### listar bienes (paginado: pagina=1, por_pagina=10 por defecto, por_pagina max 1000)

GET http://localhost:3000/bienes HTTP/1.1
Content-Type: application/json
Accept: application/json


### listar bienes con paginacion

GET http://localhost:3000/bienes?por_pagina=5&pagina=1 HTTP/1.1
Content-Type: application/json
Accept: application/json


### crear bien

POST http://localhost:3000/bienes HTTP/1.1
Content-Type: application/json
Accept: application/json

{
  "adquisicion_nro_documento": "FAC-001",
  "adquisicion_tipo_documento": "factura",
  "atributos": {
    "marca": "Dell",
    "modelo": "OptiPlex",
    "ram_gb": "16",
    "serie": "SERIE-001"
  },
  "codificador_id": "e3a94e58-80ef-4603-ad7d-1d61fc521854",
  "componentes": [],
  "descripcion": "laptop personal dell",
  "estado_fisico": "bueno",
  "fecha_adquisicion": "2026-10-09",
  "fecha_alta": "2026-10-09",
  "patrimonial": true,
  "propietario_nombre": null,
  "responsable_id": "991ace6a-727a-4211-a66a-fc4439486fbc",
  "tenencia": "propio",
  "ubicacion": "Oficina 301",
  "unidad_id": "50357eb5-79bb-4b17-9723-d8658f97c82c",
  "valor_original": "15000"
}


